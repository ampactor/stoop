#!/usr/bin/env bash
# Run the laws before every commit. CONTRIBUTING.md says there is no second,
# secret standard between local work and CI; this is what makes that true on
# the machine where the work happens, whether or not a hosted runner ever
# picks the job up.
#
# Install once, per clone:   git config core.hooksPath .githooks
# Skip deliberately, once:   git commit --no-verify
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! bash check.sh; then
  echo
  echo "commit refused: the laws do not hold."
  echo "If the failure is build drift, the fix is:"
  echo
  echo "    bash build.sh && git add index.html press/index.html artifact/"
  echo
  echo "Commit anyway with --no-verify if you know what you are doing."
  exit 1
fi
